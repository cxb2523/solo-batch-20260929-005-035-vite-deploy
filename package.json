{
  "name": "vite-deploy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify": "node packages/checks/cli.js",
    "checks:serve": "node packages/checks/server.js",
    "lint": "eslint . --ext .js,.cjs,.ts,.tsx --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^3.0.0",
    "eslint": "^8.57.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "repo-checks": "file:packages/checks",
    "typescript": "^4.9.3",
    "vite": "^4.0.0"
  }
}
